+  Host: "$host"
+  Upgrade: "$http_upgrade"
+  X-Forwarded-Proto: "$scheme"
+---
 apiVersion: networking.k8s.io/v1
 kind: Ingress
 metadata:
@@ -25,4 +36,4 @@ spec:
   tls:
     - hosts:
         - vidcall3-prod.transmedika.co.id
-      secretName: jitsi-tls
\ No newline at end of file
+      secretName: jitsi-tls
