# ==============================================================================
# Jitsi Meet on Kubernetes — Central Configuration
# ==============================================================================
# All deployment-specific values live here.
# Scripts and manifests read from this file via envsubst or source.
#
# ⚠️  BEFORE GO-LIVE: Replace all placeholder passwords marked with [ROTATE]
# ⚠️  This file is safe to commit — all credentials are placeholders only.
# ==============================================================================


# ==============================================================================
# Network & Domain
# ==============================================================================

# Public-facing domain for the Jitsi deployment
DOMAIN=vidcall3-prod.transmedika.co.id

# Public IP address (router/NAT external face)
PUBLIC_IP=157.15.164.236

# MetalLB virtual IP (internal LAN, all LB services share this)
METALLB_VIP=192.168.20.190

# Internal node IPs
CONTROL_PLANE_IP=192.168.20.180
WORKER_IP=192.168.20.177


# ==============================================================================
# Node Names
# ==============================================================================

# Kubernetes node hostnames (must match `kubectl get nodes`)
CONTROL_PLANE_NODE=srv-deploy-eng
WORKER_NODE=jenkins


# ==============================================================================
# Ports
# ==============================================================================

# JVB-1 UDP media port (LoadBalancer nodePort)
JVB1_UDP_PORT=31829

# JVB-2 UDP media port (LoadBalancer nodePort, must differ from JVB-1)
JVB2_UDP_PORT=31830

# TURN/STUN UDP port
TURN_PORT=3478


# ==============================================================================
# TLS & Certificate Management
# ==============================================================================

# Email address for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=terrence.sandward@binus.ac.id

# cert-manager ClusterIssuer to use (letsencrypt-staging or letsencrypt-prod)
CERT_ISSUER=letsencrypt-prod


# ==============================================================================
# Credentials  [ROTATE all before go-live]
# ==============================================================================

# Jicofo XMPP focus user password
JICOFO_PASSWORD=focuspass                      # [ROTATE]

# JVB XMPP auth password (shared by JVB-1 and JVB-2)
JVB_PASSWORD=jvbpass123                        # [ROTATE]

# Jibri XMPP user password
JIBRI_XMPP_PASSWORD=jibripass123              # [ROTATE]

# Jibri recorder user password (must be pinned to prevent prosody drift)
JIBRI_RECORDER_PASSWORD=jibrirecorderpass123  # [ROTATE]

# TURN/coturn HMAC shared secret
TURN_SECRET=turnpass123                        # [ROTATE]

# Grafana admin password
GRAFANA_PASSWORD=grafana123                    # [ROTATE]


# ==============================================================================
# Storage
# ==============================================================================

# Longhorn: number of volume replicas (1 = no redundancy, 2 = one copy per node)
LONGHORN_REPLICAS=2

# Jibri recordings volume size
JIBRI_STORAGE_SIZE=20Gi

# Prosody persistent storage size
PROSODY_STORAGE_SIZE=1Gi

# Prometheus retention period
PROMETHEUS_RETENTION=15d

# Prometheus storage size
PROMETHEUS_STORAGE_SIZE=10Gi


# ==============================================================================
# Recording & Features
# ==============================================================================

# Enable server-side recording via Jibri (true/false)
ENABLE_RECORDING=true

# Number of Jibri instances (each handles one concurrent recording)
JIBRI_REPLICA_COUNT=2

# Enable authentication to create rooms (false = open, anyone can create)
ENABLE_AUTH=false

# Enable guest access (requires ENABLE_AUTH=true to have any effect)
ENABLE_GUESTS=true


# ==============================================================================
# XMPP Domains  (rarely need changing)
# ==============================================================================

XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_HIDDEN_DOMAIN=hidden.meet.jitsi
JIBRI_BREWERY_MUC=jibribrewery

# ==============================================================================
# JVB Image Tag
# ==============================================================================
JITSI_IMAGE_TAG=stable-10888